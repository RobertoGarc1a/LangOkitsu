int total = 2 + 3 * 4;
println(total);
total = (2 + 3) * 4;
println(total);
println(7 / 2);
println(7 % 2);

float mitad = 7.0 / 2.0;
println(mitad);
bool valido = total >= 20 && !(mitad < 3.0);
println(valido);

